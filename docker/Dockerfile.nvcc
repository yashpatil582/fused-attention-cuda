# nvcc-only compile image for scripts/local_compile.sh (no GPU needed: nvcc never opens
# /dev/nvidia*). Built for linux/arm64 so it runs natively on the M2 Mac under colima /
# Docker Desktop; the same file works on x86_64 with --platform linux/amd64.
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04

# Ubuntu 22.04's apt cmake is 3.22, below the 3.24 this repo needs for the `native`
# architecture value and the 3.25 that CMakePresets.json version 6 needs, so CMake comes
# from PyPI instead of apt. ninja and git are the apt versions (any version is fine).
RUN apt-get update \
    && apt-get install -y --no-install-recommends ninja-build python3 python3-pip git \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --no-cache-dir "cmake>=3.25,<5"

WORKDIR /w
